{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/dispatch.mjs": {
      "includeFiles": "{src/**,migrations/**,data/**}",
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/:route*", "destination": "/api/dispatch?vcroute=:route*" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "same-origin" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" }
    ] }
  ]
}
