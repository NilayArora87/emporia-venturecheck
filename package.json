{
  "name": "venturecheck",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/server.ts",
    "seed": "node --experimental-strip-types src/seed.ts",
    "migrate": "node --experimental-strip-types src/migrate.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "backup": "node --experimental-strip-types src/backup.ts",
    "organizer": "node --experimental-strip-types src/organizer.ts",
    "host:event": "VC_DEMO=0 HOST=0.0.0.0 PORT=${PORT:-3100} VC_DB=${VC_DB:-var/college-event-test.sqlite} node --experimental-strip-types src/server.ts"
  }
}
